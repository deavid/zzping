DatabaseConfig(
    bind_host: "127.0.0.1",
    bind_port: 9443,
    tls: TlsConfig(
        ca_cert_paths: ["test_certs/ca.pem"],
        server_cert_path: "test_certs/database.pem",
        server_key_path: "test_certs/database.key",
    ),
    components: ComponentConfig(
        stale_timeout_secs: 30,
        max_collectors: 10,
    ),
)
