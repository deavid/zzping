DatabaseConfig(
    bind_host: "127.0.0.1",
    bind_port: 9444,
    tls: TlsConfig(
        ca_cert_paths: ["test_certs_rotation/ca1.pem", "test_certs_rotation/ca2.pem"],
        server_cert_path: "test_certs_rotation/database-ca1.pem",
        server_key_path: "test_certs_rotation/database.key",
    ),
    components: ComponentConfig(
        stale_timeout_secs: 30,
        max_collectors: 10,
    ),
)
